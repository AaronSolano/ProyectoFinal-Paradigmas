{
    "uid":  "profelink-overview",
    "title":  "ProfeLink Overview",
    "tags":  [
                 "profelink"
             ],
    "timezone":  "browser",
    "schemaVersion":  39,
    "version":  1,
    "refresh":  "10s",
    "time":  {
                 "to":  "now",
                 "from":  "now-15m"
             },
    "panels":  [
                   {
                       "id":  1,
                       "title":  "Request rate por servicio (req/s)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "y":  0,
                                       "w":  12,
                                       "h":  8,
                                       "x":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "profelink-prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "reqps"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "legendFormat":  "{{service_name}}",
                                           "expr":  "sum by (service_name) (rate(traces_span_metrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[1m]))",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  2,
                       "title":  "Latencia p95 por servicio",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "y":  0,
                                       "w":  12,
                                       "h":  8,
                                       "x":  12
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "profelink-prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "legendFormat":  "{{service_name}} p95",
                                           "expr":  "histogram_quantile(0.95, sum by (le, service_name) (rate(traces_span_metrics_duration_milliseconds_bucket{span_kind=\"SPAN_KIND_SERVER\"}[1m])))",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "title":  "Conexiones WebSocket activas",
                       "type":  "stat",
                       "gridPos":  {
                                       "y":  8,
                                       "w":  6,
                                       "h":  6,
                                       "x":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "profelink-prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "none"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "legendFormat":  "activas",
                                           "expr":  "sum(profelink_ws_active_connections)",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "title":  "Respuestas V/F por segundo",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "y":  8,
                                       "w":  9,
                                       "h":  6,
                                       "x":  6
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "profelink-prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ops"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "legendFormat":  "respuestas/s",
                                           "expr":  "sum(rate(profelink_game_answers_submitted_total[30s]))",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  5,
                       "title":  "Tasa de errores (spans con error)",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "y":  8,
                                       "w":  9,
                                       "h":  6,
                                       "x":  15
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "profelink-prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ops"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "legendFormat":  "{{service_name}}",
                                           "expr":  "sum by (service_name) (rate(traces_span_metrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[1m]))",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  6,
                       "title":  "Servicios reportando (salud)",
                       "type":  "stat",
                       "gridPos":  {
                                       "y":  14,
                                       "w":  6,
                                       "h":  4,
                                       "x":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "profelink-prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "none"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "legendFormat":  "servicios",
                                           "expr":  "count(count by (service_name) (traces_span_metrics_calls_total))",
                                           "refId":  "A"
                                       }
                                   ]
                   },
                   {
                       "id":  7,
                       "title":  "Latencia p95 por ruta",
                       "type":  "timeseries",
                       "gridPos":  {
                                       "y":  14,
                                       "w":  18,
                                       "h":  8,
                                       "x":  6
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "profelink-prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "ms"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "legendFormat":  "{{http_route}}",
                                           "expr":  "histogram_quantile(0.95, sum by (le, http_route) (rate(traces_span_metrics_duration_milliseconds_bucket{span_kind=\"SPAN_KIND_SERVER\"}[1m])))",
                                           "refId":  "A"
                                       }
                                   ]
                   }
               ]
}
