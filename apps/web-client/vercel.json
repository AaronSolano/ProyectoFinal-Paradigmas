{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile --filter @profelink/shared-dtos --filter @profelink/web-client",
  "buildCommand": "cd ../.. && pnpm --filter @profelink/shared-dtos build && pnpm --filter @profelink/web-client build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
