# Plantilla de producción. Copiar los valores al panel de Render.
# No poner contraseñas reales en este archivo ni en el repositorio.

# Supabase → Connect → Session pooler, puerto 5432 (IPv4).
# No usar el puerto 6543: Prisma migrate no puede aplicarse en modo transacción.
DATABASE_URL_AUTH=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=verix_auth&sslmode=require
DATABASE_URL_GAME=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?schema=game&sslmode=require

# El mismo secreto en auth-service y game-service. No cambiar la audiencia ni el emisor.
JWT_SECRET=replace-with-a-long-random-secret
JWT_AUDIENCE=profelink-game-api
JWT_ISSUER=profelink-auth-service

# Solo en el build de auth-service. El esquema local sigue siendo auth.
PRISMA_AUTH_SCHEMA=verix_auth

# Render inyecta PORT. Estos valores quedan como respaldo fuera de Render.
AUTH_PORT=3001
GAME_PORT=3002
UPLOAD_DIR=/app/uploads

# Orígenes de Vercel, separados por coma. Nunca usar *.
CORS_ORIGINS=https://VERCEL_WEB_HOST

# Variables de build de Vercel. Los hosts los asigna Render al crear cada servicio.
VITE_AUTH_API_URL=https://RENDER_AUTH_HOST
VITE_GAME_API_URL=https://RENDER_GAME_HOST
VITE_GAME_WS_URL=https://RENDER_GAME_HOST
