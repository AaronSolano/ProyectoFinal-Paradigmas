# =============================================================================
# ProfeLink — plantilla de entorno (copiar a .env antes de start.sh / start.ps1)
# =============================================================================

# --- PostgreSQL (docker-compose service: postgres-db) ---
POSTGRES_USER=profelink
POSTGRES_PASSWORD=profelink_dev
POSTGRES_DB=profelink_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# URLs por esquema (Prisma / servicios NestJS)
DATABASE_URL_AUTH=postgresql://profelink:profelink_dev@localhost:5432/profelink_db?schema=auth
DATABASE_URL_GAME=postgresql://profelink:profelink_dev@localhost:5432/profelink_db?schema=game

# --- JWT (compartido entre auth-service y game-service) ---
JWT_SECRET=change-me-use-a-long-random-secret-in-production
JWT_AUDIENCE=profelink-game-api
JWT_ISSUER=profelink-auth-service

# --- auth-service (apps/auth-service) ---
AUTH_PORT=3001
# En el contenedor auth-service usar PORT=3001
PORT_AUTH=3001

# --- game-service (apps/game-service) ---
GAME_PORT=3002
PORT_GAME=3002
UPLOAD_DIR=/app/uploads

# --- Clientes web (apps/web-client, apps/external-consumer) ---
VITE_AUTH_API_URL=http://localhost:3001
VITE_GAME_API_URL=http://localhost:3002
VITE_GAME_WS_URL=http://localhost:3002

WEB_CLIENT_PORT=5173
EXTERNAL_CONSUMER_PORT=5174

# --- Observabilidad (change 6, opcional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
GRAFANA_PORT=3000
