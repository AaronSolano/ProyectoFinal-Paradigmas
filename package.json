{
  "name": "profelink-monorepo",
  "private": true,
  "description": "ProfeLink — evaluaciones en vivo (monorepo EIF400)",
  "scripts": {
    "build": "pnpm --filter @profelink/shared-dtos build && pnpm --filter @profelink/auth-service build && pnpm --filter @profelink/game-service build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
